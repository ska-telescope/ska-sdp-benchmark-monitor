#!/usr/bin/env python3
import argparse
import logging
import os
import shutil
import subprocess


# Create argument parser
parser = argparse.ArgumentParser(description="Check for required commands and tools.")
parser.add_argument("--advice", action="store_true", help="Show advice for missing commands and tools.")
parser.add_argument("--verbose", action="store_true", help="Enable verbose output.")
args = parser.parse_args()
do_advice = args.advice
do_verbose = args.verbose

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')
log_level = logging.DEBUG if do_verbose else logging.INFO
log = logging.getLogger(__name__)
log.setLevel(log_level)

# Command advice dictionary
COMMAND_ADVICE = {
    "bc": "The 'bc' command is not available. 'bc' is a basic calculator utility required for the Bash back-end. "
          "If unavailable, consider using the C++ back-end. To install it, use:\n"
          "  - For Ubuntu/Debian: `sudo apt-get install bc`\n  - For CentOS/RHEL: `sudo yum install bc`\n"
          "  - For Fedora: `sudo dnf install bc`",
    "perf": "The 'perf' command is not available. 'perf' is a performance analysis tool that is part of the Linux "
            "kernel tools. To install it, use the following command based on your Linux distribution:\n"
            "  - For Ubuntu/Debian: `sudo apt-get install linux-tools-common linux-tools-generic`\n"
            "  - For CentOS/RHEL: `sudo yum install perf`\n  - For Fedora: `sudo dnf install perf`",
    "hpcrun": "'hpcrun' (hpctoolkit) is not available. hpctoolkit is an execution trace collection tool with low "
              "overhead without it, more expensive trace collection is still possible via perf). Install via Spack: "
              "https://hpctoolkit.org/software-instructions.html",
    "hpcstruct": "'hpcstruct' (hpctoolkit) is not available. See https://hpctoolkit.org/software-instructions.html",
    "hpcprof": "'hpcprof' (hpctoolkit) is not available. See https://hpctoolkit.org/software-instructions.html",
}

PERF_ADVICE = {
    "call_command": "The 'perf record' command requires specific kernel settings to collect call "
                    "graph data. To enable this, you need to modify the following kernel parameters:\n"
                    "  - Set `kernel.perf_event_paranoid` to -1\n"
                    "  - Set `kernel.kptr_restrict` to 0\n"
                    "You can do this by running:\n"
                    "  - `sudo sysctl -w kernel.perf_event_paranoid=-1`\n"
                    "  - `sudo sysctl -w kernel.kptr_restrict=0`\n"
                    "To make these changes permanent, add the following lines to `/etc/sysctl.conf`:\n"
                    "  - `kernel.perf_event_paranoid = -1`\n"
                    "  - `kernel.kptr_restrict = 0`\n"
                    "Then, reload the configuration with `sudo sysctl -p`."
}


def check_binary_available(cmd):
    """Check if the binary is available in the system PATH"""
    return False if shutil.which(cmd) is None else True


def check_perf_command(cmd):
    """Check if the perf command can be executed successfully"""
    return subprocess.run(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True).returncode == 0


def main():
    """
    Check if the benchmark environment is ready.
    Runs ALL checks (never stops at the first failure) so every problem is reported together in a single run.

    Returns
        bool: False only if at least one CRITICAL requirement is missing; non-critical issues are warnings only.
    """
    # Check availability of critical and optional commands
    cmd_failures = {}
    commands_dict = {"critical": ["bc"],
                     "optional": ["perf", "hpcrun", "hpcstruct", "hpcprof"]}
    for level, command_list in commands_dict.items():
        for command in command_list:
            if not check_binary_available(command):
                cmd_failures[command] = level

    # Check availability of critical and optional filesystem files
    fsf_failures = {}
    fsfiles_dict = {"critical": ["/proc/stat", "/proc/meminfo", "/proc/net/dev", "/proc/diskstats"],
                    "optional": ["/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq",
                                 "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_min_freq",
                                 "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq"]}
    fsfiles_dict["optional"].extend(
        subprocess.getoutput('ls /sys/class/infiniband/*/ports/1/counters/port*data').strip().split()
    )
    for level, file_list in fsfiles_dict.items():
        for fsfile in file_list:
            if not os.access(fsfile, os.R_OK):
                fsf_failures[fsfile] = level

    # Report command failures
    status = 0
    for command, level in cmd_failures.items():
        if do_verbose:
            log.debug(f"Checking availability of command '{command}'")
        message = f"{level} command '{command}' is not available."
        if level == "critical":
            log.error(message)
            status = 1
        elif level == "optional":
            log.warning(message)

        advice = COMMAND_ADVICE.get(command, f"{level} command '{command}' is not available.")
        if do_advice:
            log.info(advice)

    # Report filesystem file failures
    for fsfile, level in fsf_failures.items():
        if do_verbose:
            log.debug(f"Checking existence/readability of filesystem file '{fsfile}'")
        message = f"{level} filesystem file '{fsfile}' does not exist or is not readable."
        if level == "critical":
            log.error(message)
            status = 1
        elif level == "optional":
            log.warning(message)

    # Check perf-based commands
    perf_commands_dict = {
        "power_event": "perf list | grep -i power/energy | awk '{print $1}'",
        "power_command": "perf stat -A -a -e power/energy-pkg/ -I 100 -x , -- sleep 0.1",
        "call_command": "perf record --running-time -T -a -F 10 --call-graph dwarf -o /tmp/perf_test.data -- sleep 0.1"
    }
    for name, command in perf_commands_dict.items():
        if "grid5000.fr" in os.uname().nodename:
            command = "sudo-g5k " + command
        if do_verbose:
            log.debug(f"Checking availability of perf command '{name}': {command}")
        if not check_perf_command(command):
            log.warning(f"Command '{name}' failed.")
            if do_advice:
                advice = PERF_ADVICE.get(name, f"Monitoring of {name.replace('_', ' ')} will be affected.")
                log.info(advice)

    exit(status)


if __name__ == "__main__":
    main()
