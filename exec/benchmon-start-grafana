#!/usr/bin/env python3

import argparse
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path
import requests
from requests.auth import HTTPBasicAuth
import logging

from benchmon.run.run_utils import RunUtils


def parse_args() -> argparse.Namespace:
    """
    Parse command-line arguments for starting the Benchmon Grafana/InfluxDB stack.
    """
    parser = argparse.ArgumentParser(description="Start Benchmon Grafana/InfluxDB Stack")

    parser.add_argument(
        "--save-dir",
        type=Path,
        required=True,
        help="Mandatory base directory for traces"
    )

    parser.add_argument(
        "--influxdb-port",
        type=int,
        default=8181,
        help="Port for InfluxDB. Default: 8181"
    )

    parser.add_argument(
        "--influxdb-query-file-limit",
        type=int,
        default=None,
        help="Maximum number of parquet files InfluxDB may scan per query.",
    )

    parser.add_argument(
        "--grafana-port",
        type=int,
        default=3000,
        help="Port for Grafana. Default: 3000"
    )

    parser.add_argument(
        "--dashboard-dir",
        type=Path,
        default=None,
        help="Directory containing dashboard JSON files. Defaults to internal package dashboards."
    )

    parser.add_argument(
        "--grafana-path",
        type=Path,
        default=os.environ.get("BENCHMON_GRAFANA_PATH", "./benchmon-stack/grafana"),
        help="Path to Grafana installation. Defaults to ./benchmon-stack/grafana "
             "or BENCHMON_GRAFANA_PATH environment variable."
    )

    parser.add_argument(
        "--influxdb-path",
        type=Path,
        default=os.environ.get("BENCHMON_INFLUXDB_PATH", "./benchmon-stack/influxdb3"),
        help="Path to InfluxDB installation. Defaults to ./benchmon-stack/influxdb3 "
             "or BENCHMON_INFLUXDB_PATH environment variable."
    )

    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Enable verbose logging"
    )

    return parser.parse_args()


def is_port_in_use(port: int) -> bool:
    """Checks if a TCP port is in use on localhost."""
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        return s.connect_ex(('localhost', port)) == 0


def pick_available_port(requested: int, service: str, logger: logging.Logger) -> int:
    """Return the first free port at or above the requested value."""
    candidate = requested

    attempts = 0
    max_attempts = 100
    while attempts < max_attempts and is_port_in_use(candidate):
        logger.debug(f"Port {candidate} already in use for {service}, trying {candidate + 1}...")
        candidate += 1
        attempts += 1

    if attempts >= max_attempts:
        logger.error(f"Could not find a free port for {service} starting from {requested}.")
        sys.exit(1)

    if candidate != requested:
        logger.info(f"{service} port changed from {requested} to {candidate}.")

    return candidate


def setup_influxdb_datasource(grafana_port: int, influxdb_port: int, auth: tuple[str, str],
                              logger: logging.Logger) -> bool:
    """
    Configures Grafana to use InfluxDB as a data source.
    """

    # Initialize Grafana session
    grafana_url = f"http://localhost:{grafana_port}"
    logger.info("Waiting for Grafana to be ready...")
    session = requests.Session()
    session.auth = HTTPBasicAuth(*auth)

    # Bash equivalent for checking Grafana health:
    logger.debug("Bash's equivalent:\n"
                 f"curl -s -u {auth[0]}:{auth[1]} http://localhost:{grafana_port}/api/health")

    # Wait for Grafana to be ready
    start_time = time.time()
    grafana_ready = False
    timeout = 60
    while time.time() - start_time < timeout:
        try:
            response = session.get(f"{grafana_url}/api/health", timeout=timeout)  # Check Grafana health endpoint
            logger.debug(f"Grafana health check response: {response.status_code}")
            if response.status_code == 200:
                grafana_ready = True
                break
        except requests.RequestException as e:
            logger.debug(f"Grafana health check failed: {e}")
            pass
        logger.info("Grafana not ready yet, retrying in 2 seconds...")
        time.sleep(2)

    if not grafana_ready:
        logger.error("Grafana did not become available in time. Please check logs.")
        logger.error("Consider stopping the services here if Grafana fails to start.")
        sys.exit(1)

    logger.info("Grafana is up. Configuring datasource and dashboards...")

    # Configure the payload for the InfluxDB datasource
    payload = {
        "name": "InfluxDB v3 SQL",
        "type": "influxdb",
        "uid": "influxdb-v3-sql",
        "access": "proxy",
        "url": f"http://localhost:{influxdb_port}",
        "basicAuth": False,
        "isDefault": True,
        "jsonData": {
            "dbName": "metrics",
            "queryLanguage": "sql",
            "version": "SQL",
            "httpMode": "GET",
            "tlsSkipVerify": True,
            "insecureConnection": True,
            "insecureGrpc": True
        },
        "secureJsonData": {}
    }

    response = session.get(f"{grafana_url}/api/datasources/uid/{payload['uid']}")

    logger.debug(f"Bash's equivalent:\n"
                 f"curl -s -u {auth[0]}:{auth[1]} http://localhost:{grafana_port}/api/datasources/uid/{payload['uid']}")

    if response.status_code == 200:
        logger.info("Datasource already exists, skipping creation.")
        return True
    else:
        response = session.post(
            f"{grafana_url}/api/datasources",
            json=payload,
            headers={"Content-Type": "application/json"}
        )
        logger.debug(f"Bash's equivalent:\n"
                     f"curl -s -u {auth[0]}:{auth[1]} http://localhost:{grafana_port}/api/datasources"
                     f" -X POST -H 'Content-Type: application/json' -d '{json.dumps(payload)}'")
        if response.status_code in (200, 201):
            logger.info("Datasource created successfully.")
            return True
        else:
            logger.error(f"Error creating datasource: {response.status_code} {response.text}")
            return False


def setup_grafana_dashboards(grafana_port: int, dashboard_dir: Path, auth: tuple[str, str],
                             logger: logging.Logger) -> bool:
    """
    Uploads dashboards from the specified directory to Grafana.
    """
    grafana_url = f"http://localhost:{grafana_port}"
    session = requests.Session()
    session.auth = HTTPBasicAuth(*auth)

    if not dashboard_dir.is_dir():
        logger.error(f"Dashboard directory {dashboard_dir} does not exist or is not a directory.")
        return False

    for dashboard_file in dashboard_dir.glob("*.json"):
        logger.info(f"Uploading dashboard: {dashboard_file.name}")
        with open(dashboard_file, "r") as f:
            dashboard_json = json.load(f)

        payload = {
            "dashboard": dashboard_json,
            "overwrite": True,
            "message": f"Uploaded {dashboard_file} via benchmon-run-grafana"
        }

        if "id" in payload["dashboard"]:
            del payload["dashboard"]["id"]

        response = session.post(
            f"{grafana_url}/api/dashboards/db",
            json=payload,
            headers={"Content-Type": "application/json"}
        )
        logger.debug(f"Bash's equivalent:\n"
                     f"curl -s -u {auth[0]}:{auth[1]} http://localhost:{grafana_port}/api/dashboards/db"
                     f" -X POST -H 'Content-Type: application/json' -d '{json.dumps(payload)}'")


        if response.status_code in (200, 201):
            logger.info(f"Dashboard {dashboard_file.name} uploaded successfully.")
        else:
            logger.error(f"Error uploading dashboard {dashboard_file.name}: {response.status_code} {response.text}")
            return False

    return True


def main():
    """
    Main function to start InfluxDB and Grafana, configure them, and upload dashboards.
    """

    args = parse_args()

    # Runtime directories
    runtime_dir = args.save_dir / "grafana-data"
    runtime_dir.mkdir(parents=True, exist_ok=True)

    # Setup logging
    log_dir = runtime_dir / "logs"  # @hardcoded
    log_dir.mkdir(exist_ok=True)    # @hardcoded
    logger = RunUtils.create_logger(save_dir=log_dir, verbose=args.verbose, logfilename="benchmon-start-grafana.log")

    # Validate the --influxdb-query-file-limit argument
    if not isinstance(args.influxdb_query_file_limit, int) or args.influxdb_query_file_limit < 1:
        logger.error("--influxdb-query-file-limit must be a positive integer")
        sys.exit(1)

    # --- MODIFICATION: Programmatically find default dashboard directory ---
    if args.dashboard_dir is None:
        import benchmon.visualization
        fallback_path = Path(benchmon.visualization.__file__).parent
        if fallback_path.is_dir():
            args.dashboard_dir = fallback_path
            logger.info(f"--dashboard-dir not provided, using fallback development path: {args.dashboard_dir}")


    # [InfluxDB] Check for the binary
    influxdb3_binary = f"{(args.influxdb_path / 'influxdb3').resolve()}"  # Resolved absolute path
    if not Path(influxdb3_binary).is_file():
        logger.error(f"InfluxDB binary not found at {influxdb3_binary} \n"
                     "Hint: Set the BENCHMON_INFLUXDB_PATH environment variable "
                     "or use --influxdb-path to specify the path.")
        sys.exit(1)

    # [Grafana] Check for the binary
    grafana_binary = f"{(args.grafana_path / 'bin/grafana-server').resolve()}"  # Resolved absolute path
    if not Path(grafana_binary).is_file():
        logger.error(f"Grafana binary not found at {grafana_binary} \n"
                     "Hint: Set the BENCHMON_GRAFANA_PATH environment variable "
                     "or use --grafana-path to specify the path.")
        sys.exit(1)

    # PIDs dict for influxdb and grafana processes
    pids = {}

    # [InfluxDB] Create data directory
    influxdb_data_dir = runtime_dir / "influxdb_data"
    influxdb_data_dir.mkdir(exist_ok=True)

    # [InfluxDB] Set port
    influxdb_port = pick_available_port(args.influxdb_port, "InfluxDB", logger)
    logger.info(f"Starting InfluxDB on port {influxdb_port}...")

    # [InfluxDB] Create the execution command with the specified parameters
    node_id = "benchmon-node-id"
    logger.info(f"InfluxDB using node-id: {node_id}")
    influxdb_command = [
        influxdb3_binary, "serve",
        "--object-store", "file",
        "--node-id", node_id,
        "--http-bind", f"0.0.0.0:{influxdb_port}",
        "--data-dir", str(influxdb_data_dir),
        "--without-auth"
    ]

    # [InfluxDB] Check if --influxdb-query-file-limit is set and append to command
    if args.influxdb_query_file_limit:
        influxdb_command.extend([
            "--query-file-limit", str(args.influxdb_query_file_limit)
        ])
        logger.info(f"InfluxDB query file limit set to {args.influxdb_query_file_limit} parquet files per query.")

    # [InfluxDB] Bash helper for reference
    """Bash helper
    influxdb server --object-store file --node-id benchmon-node-id \
                    --http-bind 0.0.0.0:<port> --data-dir <influxdb_datadir> \
                    --without-auth
                    --query-file-limit <limit>
    """
    logger.debug(f"InfluxDB command:\n{' '.join(influxdb_command)}")

    # [InfluxDB] Run the process, redirect the log, get PID
    influx_log_file = log_dir / "influxdb.log"
    with open(influx_log_file, "w") as log:  # @hardcoded log should be directed to verbose global logger
        influx_process = subprocess.Popen(influxdb_command, stdout=log, stderr=subprocess.STDOUT)
    pids["influxdb"] = influx_process.pid
    logger.info(f"InfluxDB started with PID: {influx_process.pid}. Log: {influx_log_file}")
    logger.info(f"InfluxDB data directory: {influxdb_data_dir} Database: metrics")

    # [Grafana] Set port
    grafana_port = pick_available_port(args.grafana_port, "Grafana", logger)
    logger.info(f"Starting Grafana on port {grafana_port}...")

    # [Grafana] Create the execution command with the specified parameters
    grafana_command = [
        grafana_binary,
        "--config", f"{args.grafana_path}/conf/defaults.ini",
        "--homepath", f"{args.grafana_path}",
        f"cfg:server.http_port={grafana_port}"
    ]

    # [Grafana] hardcoded admin credentials for local development
    GF_SECURITY_ADMIN_USER = "admin"
    GF_SECURITY_ADMIN_PASSWORD = "admin123"

    # [Grafana] Bash helper for reference
    """Bash helper
    export GF_SECURITY_ADMIN_USER=admin
    export GF_SECURITY_ADMIN_PASSWORD=admin123
    grafana-server --config <grafana_path>/conf/defaults.ini \
                   --homepath <grafana_path> \
                   cfg:server.http_port=<port>
    """
    logger.debug(f"Grafana command:\n GF_SECURITY_ADMIN_USER={GF_SECURITY_ADMIN_USER} "
                 f"GF_SECURITY_ADMIN_PASSWORD={GF_SECURITY_ADMIN_PASSWORD} "
                 f"{' '.join(grafana_command)}")

    # [Grafana] Set environment variables for admin user and password
    grafana_env = os.environ.copy()
    grafana_env.setdefault("GF_SECURITY_ADMIN_USER", GF_SECURITY_ADMIN_USER)
    grafana_env.setdefault("GF_SECURITY_ADMIN_PASSWORD", GF_SECURITY_ADMIN_PASSWORD)

    # [Grafana] Run the process, redirect the log, get PID
    grafana_log_file = log_dir / "grafana.log"
    with open(grafana_log_file, "w") as log:
        grafana_process = subprocess.Popen(grafana_command, stdout=log, stderr=subprocess.STDOUT, env=grafana_env)
    pids["grafana"] = grafana_process.pid
    logger.info(f"Grafana started with PID: {grafana_process.pid}. Log: {grafana_log_file}")

    # Write PID file
    pid_file = runtime_dir / "pids.json"
    with open(pid_file, "w") as f:
        json.dump(pids, f)
    logger.info(f"PIDs saved to {pid_file}")

    # Write connection info file
    hostname = socket.gethostname().split(".")[0]
    connection_info = {
        "influxdb_url": f"http://{hostname}:{influxdb_port}",
        "grafana_url": f"http://{hostname}:{grafana_port}",
        "influxdb_token": ""  # Placeholder for token
    }
    connecfile = runtime_dir / "connection.json"
    with open(connecfile, "w") as f:
        json.dump(connection_info, f)
    logger.info(f"Connection info saved to {connecfile}")

    # Setup InfluxDB data source in Grafana
    if not setup_influxdb_datasource(grafana_port=args.grafana_port, influxdb_port=influxdb_port,
                                     auth=(GF_SECURITY_ADMIN_USER, GF_SECURITY_ADMIN_PASSWORD),
                                     logger=logger):
        logger.error("Failed to set up InfluxDB data source in Grafana.")
        sys.exit(1)

    # Upload dashboards
    if not setup_grafana_dashboards(grafana_port=args.grafana_port, dashboard_dir=fallback_path,
                                    auth=(GF_SECURITY_ADMIN_USER, GF_SECURITY_ADMIN_PASSWORD),
                                    logger=logger):
        logger.error("Failed to upload one or more dashboards to Grafana.")
        sys.exit(1)

    logger.info(f"InfluxDB is ready at http://{hostname}:{influxdb_port}")
    logger.info(f"Grafana is ready at http://{hostname}:{grafana_port}")
    logger.debug(f"Local port forwarding:\n ssh -N -L {influxdb_port}:{hostname}:{influxdb_port} "
                 f"-L {grafana_port}:{hostname}:{grafana_port} <user>@<frontend>")
    logger.info("Monitoring stack started and configured successfully.")


if __name__ == "__main__":
    main()
