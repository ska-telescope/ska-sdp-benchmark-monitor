#!/usr/bin/bash

args=""
save_dir_arg=""
hpcrun_flags=""
level=""
index=0
# Load environment variables exported by the Python benchmon-config script
eval "$($(dirname ${BASH_SOURCE[0]})/benchmon-config)"

# Priority 2: parse command line args
while [[ $# -gt 0 ]]; do
    case $1 in
        "-l" | "--level")
            level=$2
            shift 2
            ;;
        "-d" | "--save-dir")
            save_dir_arg=$2
            shift 2
            ;;
	"-e" | "--hpc-exe")
            while [[ $2 != "-"* && -n $2 ]]; do
                exe[((index++))]=$2
                shift 1
            done
            shift 1
            ;;
	"-f" | "--hpc-flags")
            hpcrun_flags=$2
	    shift 2
	    ;;
        *)
            args="$args $1"
            shift 1
            ;;
    esac
done

# Priority 1: BENCHMON_ARGS overrides level, save-dir, verbose + adds extra args to benchmon-run
if [[ -n "${BENCHMON_ARGS}" ]]; then
    echo "[INFO]: BENCHMON_ARGS is set, overriding matching arguments." >&2
    eval set -- "$BENCHMON_ARGS"
    while [[ $# -gt 0 ]]; do
        case $1 in
            "-l" | "--level")
                level=$2
                shift 2
                ;;
            "-d" | "--save-dir")
                save_dir_arg=$2
                shift 2
                ;;
            "-v" | "--verbose")
                args="$args --verbose"
                shift 1
                ;;
            *)
                args="$args $1"  # extra args (--sys-freq, --call, etc.) passed to benchmon-run
                shift 1
                ;;
        esac
    done
fi

# Priority 3: defaults
level=${level:-0}
save_dir_arg="${save_dir_arg:-./benchmon_savedir_${SLURM_JOB_ID}${OAR_JOB_ID}}"

if [[ -n $level ]]; then
    save_dir_arg=${save_dir_arg:-"./benchmon_savedir_${SLURM_JOB_ID}${OAR_JOB_ID}"}
    echo "[INFO]: benchmon-start level=$level save-dir=$save_dir_arg" >&2

fi

if [[ -n $save_dir_arg ]]; then
    args="$args --save-dir $save_dir_arg"
fi

if [[ $level == 0 ]]; then
    $(dirname ${BASH_SOURCE[0]})/benchmon-hardware --save-dir $save_dir_arg
    $(dirname ${BASH_SOURCE[0]})/benchmon-software --save-dir $save_dir_arg
    args="--sys --sys-freq 1 $args"
    # Collect data with hpctoolkit only if hpc-exe and hpc-flags have been passed,
    # (this is not standard for level 0 so there are no defaults)
    if [[ ${#exe[@]} != 0 && -n "$hpcrun_flags" ]]; then
        echo "[INFO] benchmon: tracing ${exe[*]} with \"$hpcrun_flags\" in $save_dir_arg"
        mkdir -p ${save_dir_arg}/hpctoolkit_traces
        source $BENCHMON_LIB_PATH/run/tracing_wrappers.sh --save-dir ${save_dir_arg}/hpctoolkit_traces --hpc-flags "$hpcrun_flags" --hpc-exe ${exe[*]}
    fi

elif [[ $level == 1 ]]; then
    # Collect overall performance metrics with hpctoolkit if executables have been passed, otherwise rely on perf
    if [[ ${#exe[@]} != 0 ]]; then
        # Collect overall performance metrics with hpctoolkit, if no hpc-flags have been passed use defaults
        args="--sys --sys-freq 1 --timing $args" # --pow --pow-freq 10
    else
        args="--sys --sys-freq 1 --call --call-prof-freq 1 --timing $args" # --pow --pow-freq 10
    fi

elif [[ $level == 2 ]]; then
    # Collect execution traces with hpctoolkit if executables have been passed, otherwise rely on perf
    if [[ ${#exe[@]} != 0 ]]; then
        # if no hpc-flags have been passed use defaults
        args="--sys --sys-freq 10 --timing-mapping $args" # --pow --pow-freq 10
    else
        args="--sys --sys-freq 10 --call --call-prof-freq 50 --timing-mapping $args" # --pow --pow-freq 10
    fi
fi

$(dirname ${BASH_SOURCE[0]})/benchmon-run $args &

echo "[INFO]: benchmon-run args: $args" >&2
# In case this file was sourced, unset all local variables
unset args save_dir_arg hpcrun_flags index level exe
